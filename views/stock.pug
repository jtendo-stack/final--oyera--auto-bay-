extends layout
block content
  .row.g-4
    .col-lg-5
      .card.shadow-sm.border-0
        .card-body
          h2 Add New Stock
          if error
            .alert.alert-danger(role='alert')= error
          form(action='/add-stock' method='POST')
            .mb-3
              label.form-label(for='itemName') Item Name
              input#itemName.form-control(type='text' name='itemName' placeholder='Engine Oil, Brake Fluid, Oil Filter' required)
            .mb-3
              label.form-label(for='quantity') Quantity
              input#quantity.form-control(type='number' name='quantity' required min='0')
            .mb-3
              label.form-label(for='price') Price UGX
              input#price.form-control(type='number' name='price' placeholder='79000-200000' required min='0')
            button.btn.btn-success.w-100(type='submit') Add to Stock
    .col-lg-7
      .card.shadow-sm.border-0
        .card-body
          h2 Current Stock
          if stock && stock.length
            .table-responsive
              table.table.table-hover.align-middle
                thead.table-success
                  tr
                    th Item
                    th Quantity
                    th Price UGX
                tbody
                  each item in stock
                    tr
                      td= item.itemName || '—'
                      td= item.quantity || 0
                      td= Number(item.price || 0).toLocaleString()
          else
            .alert.alert-info.mb-0 No stock items added yet.
doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= title
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/style.css')
  body
    nav.navbar.navbar-dark.bg-success.shadow-sm
      .container
        a.navbar-brand.d-flex.align-items-center.gap-2(href='/')
          img(src='/logo.svg' alt='Oyera Auto Bay logo' width='120' height='42')
        .navbar-nav.flex-row.flex-wrap.align-items-center.gap-2.ms-auto
          a.nav-link(href='/') Home
          if !userRole
            a.nav-link(href='/register') Register
            a.nav-link(href='/login') Login
          else
            if userRole === 'customer'
              a.nav-link(href='/book') New Service
            if userRole === 'technician'
              a.nav-link(href='/dashboard') Bookings
              a.nav-link(href='/records') Records
            if userRole === 'senior'
              a.nav-link(href='/admin') Management
              a.nav-link(href='/dashboard') Bookings
              a.nav-link(href='/records') Records
              a.nav-link(href='/stock') Parts Stock
              a.nav-link(href='/technicians') Technicians
            if userRole !== 'customer'
              a.nav-link(href='/customers') Customers
            a.nav-link(href='/logout') Logout
          if userName
            span.navbar-text.text-white-50.ms-3 Logged in: #{userName} (#{userRole})
    .container.py-4
      .page-shell
        h1.page-title= pageTitle
        block content
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')